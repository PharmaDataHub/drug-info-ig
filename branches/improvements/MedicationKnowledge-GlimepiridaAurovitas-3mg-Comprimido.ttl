           fhir:text [ fhir:v "Passagem de insulina" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Em casos excecionais de doentes diabéticos tipo 2 controlados com insulina, pode ser indicada a passagem para glimepirida." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A passagem deve ser feita sob vigilância médica estreita." ]
           ] )
         ] )
       ] ) ;
