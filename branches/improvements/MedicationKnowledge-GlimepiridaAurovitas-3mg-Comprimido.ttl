  fhir:name ( [ fhir:v "Glimepirida Aurovitas [glimepirida] 3 mg comprimido"] ) ; # 
  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:coding ( [
           a sct:44054006 ;
           fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "44054006" ] ;
           fhir:display [ fhir:v "Diabetes mellitus type 2" ]
         ] ) ;
         fhir:text [ fhir:v "Tratamento da diabetes mellitus tipo 2, quando a dieta, exercício físico e redução de peso por si só não são suficientes" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose inicial e de manutenção" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Dose inicial de 1 mg de glimepirida por dia. Se for alcançado um bom controlo, esta dose deve ser usada na terapêutica de manutenção." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Tomar pouco antes ou durante um pequeno-almoço substancial ou, caso não seja tomado, pouco antes ou durante a primeira refeição principal. Se uma dose for esquecida, não deve ser corrigido aumentando a dose seguinte." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ]
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Titulação em caso de controlo insatisfatório" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Aumento gradual da posologia para 2 mg, 3 mg ou 4 mg de glimepirida por dia, com intervalos de cerca de 1 a 2 semanas entre cada aumento da dose. A dose máxima recomendada é de 6 mg de glimepirida por dia." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Doses superiores a 4 mg de glimepirida por dia só dão melhores resultados em casos excecionais." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:maxDosePerPeriod ( [
             fhir:numerator [
               fhir:value [ fhir:v "6"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ] ;
             fhir:denominator [
               fhir:value [ fhir:v "1"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "day" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "d" ]
             ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Terapêutica concomitante com metformina" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Em doentes não controlados adequadamente com a dose diária máxima de metformina, mantendo a dose de metformina, a glimepirida é iniciada com uma dose baixa e aumentada por titulação, dependendo do nível desejado de controlo metabólico, até à dose diária máxima." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A terapêutica de combinação deve ser iniciada sob estrita vigilância médica." ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Terapêutica concomitante com insulina" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Em doentes não controlados adequadamente com a dose máxima diária de glimepirida, pode ser iniciada insulina, se necessário. Mantendo a mesma dose de glimepirida, a insulina é iniciada com uma dose baixa e aumentada por titulação em função do nível desejado de controlo metabólico." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A terapêutica de combinação deve ser iniciada sob estrita vigilância médica." ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Passagem de outros antidiabéticos orais" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose inicial recomendada é de 1 mg de glimepirida por dia; com base na resposta, a dose pode ser aumentada gradualmente, como indicado anteriormente." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Deve ter-se em consideração a potência e a semivida da medicação anterior. Nalguns casos, especialmente em antidiabéticos com semivida longa (por exemplo, clorpropamida), é recomendado um período de wash out de alguns dias para minimizar o risco de reações hipoglicémicas devidas ao efeito aditivo." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
