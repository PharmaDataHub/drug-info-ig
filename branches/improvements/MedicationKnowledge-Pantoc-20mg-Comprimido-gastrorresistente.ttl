     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Tratamento de manutenção e prevenção das recidivas da esofagite de refluxo (adultos e adolescentes com idade igual ou superior a 12 anos)" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose de manutenção" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Um comprimido de Pantoc 20 mg por dia." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Engolir os comprimidos inteiros (sem mastigar ou partir) com um pouco de água 1 hora antes de uma refeição." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Quantity ;
               fhir:value [ fhir:v "20"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Dose em caso de recidiva" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Aumentar para 40 mg de pantoprazol por dia se houver recidiva." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Para esta situação está disponível Pantoc 40 mg comprimido." ]
           ] )
