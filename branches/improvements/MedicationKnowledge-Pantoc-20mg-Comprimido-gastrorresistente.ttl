  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Tratamento da doença de refluxo gastroesofágico e dos sintomas associados (adultos e adolescentes com idade igual ou superior a 12 anos)" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Tratamento inicial" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Um comprimido de Pantoc 20 mg por dia. O alívio dos sintomas é geralmente conseguido dentro de 2-4 semanas." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Engolir os comprimidos inteiros (sem mastigar ou partir) com um pouco de água 1 hora antes de uma refeição." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:bounds [
                 a fhir:Range ;
                 fhir:low [
                   fhir:value [ fhir:v "2"^^xsd:decimal ] ;
                   fhir:unit [ fhir:v "week" ] ;
                   fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                   fhir:code [ fhir:v "wk" ]
                 ] ;
                 fhir:high [
                   fhir:value [ fhir:v "4"^^xsd:decimal ] ;
                   fhir:unit [ fhir:v "week" ] ;
                   fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                   fhir:code [ fhir:v "wk" ]
                 ]
               ] ;
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Quantity ;
               fhir:value [ fhir:v "20"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Período de tratamento adicional" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Se o alívio dos sintomas não for suficiente é geralmente alcançado num período de tratamento adicional de 4 semanas (20 mg uma vez por dia)." ] ;
           fhir:timing [
             fhir:repeat [
               fhir:bounds [
                 a fhir:Duration ;
                 fhir:value [ fhir:v "4"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "week" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "wk" ]
               ] ;
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Quantity ;
               fhir:value [ fhir:v "20"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Regime on-demand" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Após alívio sintomático os sintomas recorrentes podem ser controlados com um regime on-demand de 20 mg uma vez por dia tomando um comprimido quando necessário." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A mudança para uma terapêutica contínua pode ser considerada se não for conseguido um controlo satisfatório dos sintomas com o tratamento on-demand." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:asNeeded [ fhir:v true ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Quantity ;
