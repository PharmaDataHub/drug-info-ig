  fhir:name ( [ fhir:v "Concor [Bisoprolol] 5 mg Comprimido revestido"] ) ; # 
  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Tratamento da hipertensão" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose habitual diária" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "5 mg de bisoprolol, fumarato, uma vez por dia; se necessário, a dose pode ser aumentada para 10 mg uma vez por dia. Dose máxima recomendada: 20 mg uma vez por dia." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A dose deve ser ajustada individualmente, tendo em conta a frequência cardíaca e a eficácia terapêutica. Tratamento geralmente de longa duração; não deve ser interrompido abruptamente, especialmente em doentes com doença isquémica cardíaca (recomenda-se a redução gradual da dose). Tomar de manhã, com ou sem alimentos, engolindo os comprimidos com um pouco de líquido, sem os mastigar." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ] ;
               fhir:when ( [ fhir:v "MORN" ] )
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Range ;
               fhir:low [
                 fhir:value [ fhir:v "5"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ] ;
               fhir:high [
                 fhir:value [ fhir:v "10"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ]
             ]
           ] ) ;
           fhir:maxDosePerPeriod ( [
             fhir:numerator [
               fhir:value [ fhir:v "20"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ] ;
             fhir:denominator [
               fhir:value [ fhir:v "1"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "day" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "d" ]
             ]
           ] )
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
