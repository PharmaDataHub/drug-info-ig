       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Doentes com insuficiência renal ou hepática de gravidade ligeira a moderada" ]
         ]
       ] )
