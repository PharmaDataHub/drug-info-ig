  <indicationGuideline>
    <indication>
      <concept>
        <text value="Redução do risco de ocorrência e recorrência de um acidente vascular cerebral, em doentes que sofreram acidente vascular cerebral isquémico constituído, acidente vascular cerebral menor, défice neurológico reversível de origem isquémica ou acidente isquémico transitório (AIT), incluindo cegueira unilateral transitória"/>
      </concept>
    </indication>
    <dosingGuideline>
      <dosage>
        <type>
          <text value="Posologia habitual"/>
        </type>
        <dosage>
          <text value="A posologia habitual é de dois comprimidos por dia, a tomar durante as refeições."/>
          <additionalInstruction>
            <text value="Os comprimidos devem ser ingeridos com água e sem mastigar."/>
          </additionalInstruction>
        </dosage>
      </dosage>
      <patientCharacteristic>
        <type>
          <text value="Population"/>
        </type>
        <valueCodeableConcept>
          <text value="Adultos"/>
        </valueCodeableConcept>
      </patientCharacteristic>
    </dosingGuideline>
