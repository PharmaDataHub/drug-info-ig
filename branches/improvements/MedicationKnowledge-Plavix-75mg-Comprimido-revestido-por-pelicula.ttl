           fhir:text [ fhir:v "População pediátrica" ]
         ]
       ] )
     ] )
  ] [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Síndrome coronária aguda sem elevação do segmento ST (angina instável ou enfarte de miocárdio sem onda Q), incluindo doentes em processo de colocação de um stent após intervenção coronária percutânea, em associação com ácido acetilsalicílico (AAS)" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose de carga" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A terapêutica deve ser iniciada com uma dose de carga de 300 mg ou de 600 mg em toma única." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Uma dose de carga de 600 mg pode ser considerada em doentes <75 anos de idade quando se pretende realizar uma intervenção coronária percutânea." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:count [ fhir:v "1"^^xsd:positiveInteger ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Range ;
               fhir:low [
                 fhir:value [ fhir:v "300"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ] ;
               fhir:high [
                 fhir:value [ fhir:v "600"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ]
             ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Manutenção" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "O tratamento com clopidogrel deve continuar com 75 mg uma vez por dia (com ácido acetilsalicílico, AAS, 75 mg - 325 mg por dia). O uso é justificado até 12 meses, observando-se o benefício máximo aos 3 meses." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Dado que doses mais elevadas de ácido acetilsalicílico estão associadas a um maior risco hemorrágico, recomenda-se que a dose de ácido acetilsalicílico não seja superior a 100 mg. A duração ótima do tratamento não foi formalmente estabelecida." ]
           ] [
             fhir:text [ fhir:v "Se não for tomada uma dose: até 12 horas após a última toma, tomar de imediato e tomar a dose seguinte no horário normal; por mais de 12 horas, tomar a dose seguinte no horário habitual e não tomar a dose a dobrar." ]
           ] ) ;
           fhir:timing [
