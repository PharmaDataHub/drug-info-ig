         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Adultos e idosos" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose de carga de 600 mg" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Uma dose de carga de 600 mg pode ser considerada em doentes com <75 anos de idade, quando se pretende uma intervenção coronária percutânea." ] ;
           fhir:timing [
             fhir:repeat [
               fhir:count [ fhir:v "1"^^xsd:positiveInteger ]
             ]
