  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Prevenção secundária de acidentes aterotrombóticos em doentes adultos com enfarte de miocárdio, acidente vascular cerebral isquémico ou doença arterial periférica estabelecida" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Toma única diária" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "O clopidogrel deve ser administrado sob a forma de uma toma única diária de 75 mg." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Pode ser administrado com ou sem alimentos. Se não for tomada uma dose: até 12 horas após a última toma, tomar de imediato e tomar a dose seguinte no horário normal; por mais de 12 horas, tomar a dose seguinte no horário habitual e não tomar a dose a dobrar." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Quantity ;
               fhir:value [ fhir:v "75"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ]
           ] )
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Adultos e idosos" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Uso não recomendado" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "O clopidogrel não deve ser utilizado em crianças por motivos de eficácia." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
