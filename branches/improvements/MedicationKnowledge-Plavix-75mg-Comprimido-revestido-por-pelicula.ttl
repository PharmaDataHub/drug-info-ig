     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Enfarte agudo do miocárdio com elevação do segmento ST, em associação com ácido acetilsalicílico (AAS), em doentes submetidos a intervenção coronária percutânea (incluindo colocação de stent) ou em doentes sujeitos a tratamento médico indicados para terapêutica trombolítica/fibrinolítica" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Tratamento médico (terapêutica trombolítica/fibrinolítica): dose de carga" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Para doentes sujeitos a tratamento médico, indicados para terapêutica trombolítica/fibrinolítica, o clopidogrel deve ser iniciado com uma dose de carga de 300 mg." ] ;
           fhir:timing [
