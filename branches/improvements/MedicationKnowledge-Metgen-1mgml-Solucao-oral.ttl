         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose única recomendada é 10 mg, repetida até 3 vezes ao dia. A dose diária máxima recomendada é 30 mg ou 0,5 mg/kg de peso corporal. A duração máxima do tratamento recomendada é 5 dias." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Respeitar um intervalo mínimo de 6 horas entre duas administrações, mesmo no caso de vómitos ou rejeição da dose." ]
           ] ) ;
           fhir:timing [
