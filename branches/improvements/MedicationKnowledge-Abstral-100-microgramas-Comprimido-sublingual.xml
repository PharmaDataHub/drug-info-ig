        </type>
        <dosage>
          <text value="Abstral não deverá ser utilizado em crianças com idade inferior a 18 anos devido à ausência de dados de segurança e eficácia."/>
        </dosage>
      </dosage>
      <patientCharacteristic>
        <type>
