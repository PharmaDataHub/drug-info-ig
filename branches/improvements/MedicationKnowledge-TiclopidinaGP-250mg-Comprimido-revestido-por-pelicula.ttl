  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Redução do risco de ocorrência e recorrência de um acidente vascular cerebral, em doentes que sofreram acidente vascular cerebral isquémico constituído, acidente vascular cerebral menor, défice neurológico reversível de origem isquémica ou acidente isquémico transitório (AIT), incluindo cegueira unilateral transitória" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Posologia habitual" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A posologia habitual é de dois comprimidos por dia, a tomar durante as refeições." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Os comprimidos devem ser ingeridos com água e sem mastigar." ]
           ] )
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Adultos" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Sem ajuste posológico" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Embora a farmacocinética da ticlopidina se encontre alterada no idoso, a atividade farmacológica e terapêutica, na dose de 500 mg por dia, não é afetada pela idade." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Utilização no idoso" ]
         ]
       ] )
     ] [
