  <name value="Triveram [Atorvastatina + Perindopril + Amlodipina] 10 mg + 5 mg + 5 mg Comprimido revestido por película"/>
  <indicationGuideline>
    <indication>
      <concept>
        <text value="Tratamento da hipertensão arterial essencial e/ou da doença arterial coronária estável, em associação com hipercolesterolemia primária ou hiperlipidemia mista, como terapia de substituição em doentes adultos adequadamente controlados com atorvastatina, perindopril e amlodipina administrados concomitantemente com a mesma dosagem da associação fixa, mas como produtos separados"/>
      </concept>
    </indication>
    <dosingGuideline>
      <dosage>
        <type>
          <text value="Dose habitual diária"/>
        </type>
        <dosage>
          <text value="A posologia usual é de 1 comprimido diário, tomado como dose única uma vez por dia, de manhã antes de uma refeição."/>
          <additionalInstruction>
            <text value="A associação fixa não é adequada para terapêutica inicial. Se for necessária uma mudança de posologia, a titulação deve ser feita com os componentes individuais."/>
          </additionalInstruction>
          <additionalInstruction>
            <text value="Nos doentes em tratamento com os agentes antivirais elbasvir/grazoprevir para a hepatite C ou letermovir para a profilaxia da infeção por citomegalovírus concomitantemente com Triveram, a dose de atorvastatina no Triveram não deverá exceder 20 mg/dia. Não se recomenda a utilização de Triveram em doentes a tomar letermovir administrado concomitantemente com ciclosporina."/>
          </additionalInstruction>
          <timing>
            <repeat>
              <frequency value="1"/>
              <period value="1"/>
              <periodUnit value="d"/>
              <when value="ACM"/>
            </repeat>
          </timing>
          <doseAndRate>
            <doseQuantity>
              <value value="1"/>
              <unit value="comprimido"/>
              <system value="http://unitsofmeasure.org"/>
              <code value="{tablet}"/>
            </doseQuantity>
          </doseAndRate>
          <maxDosePerPeriod>
            <numerator>
              <value value="1"/>
              <unit value="comprimido"/>
              <system value="http://unitsofmeasure.org"/>
              <code value="{tablet}"/>
            </numerator>
            <denominator>
              <value value="1"/>
              <unit value="day"/>
              <system value="http://unitsofmeasure.org"/>
              <code value="d"/>
            </denominator>
          </maxDosePerPeriod>
        </dosage>
      </dosage>
      <patientCharacteristic>
        <type>
          <text value="Population"/>
        </type>
        <valueCodeableConcept>
          <text value="Adultos"/>
        </valueCodeableConcept>
      </patientCharacteristic>
    </dosingGuideline>
    <dosingGuideline>
      <dosage>
        <type>
          <text value="Dose em doentes com compromisso renal"/>
        </type>
        <dosage>
          <text value="Triveram pode ser administrado a doentes com depuração da creatinina ≥ 60 ml/min e não é adequado para doentes com depuração da creatinina &lt; 60 ml/min. Nestes doentes, recomenda-se uma titulação individual da dose com os monocomponentes."/>
        </dosage>
      </dosage>
      <patientCharacteristic>
        <type>
          <text value="Population"/>
        </type>
        <valueCodeableConcept>
          <text value="Doentes com compromisso renal"/>
        </valueCodeableConcept>
      </patientCharacteristic>
    </dosingGuideline>
    <dosingGuideline>
      <dosage>
        <type>
          <text value="Dose em doentes com compromisso hepático"/>
        </type>
        <dosage>
          <text value="Triveram deve ser usado com precaução em doentes com compromisso hepático. Triveram está contraindicado em doentes com doença hepática ativa."/>
        </dosage>
      </dosage>
      <patientCharacteristic>
        <type>
          <text value="Population"/>
        </type>
        <valueCodeableConcept>
          <text value="Doentes com compromisso hepático"/>
        </valueCodeableConcept>
      </patientCharacteristic>
    </dosingGuideline>
    <dosingGuideline>
      <dosage>
        <type>
          <text value="Dose em doentes idosos"/>
        </type>
        <dosage>
          <text value="Os doentes idosos podem ser tratados com Triveram de acordo com a função renal."/>
        </dosage>
