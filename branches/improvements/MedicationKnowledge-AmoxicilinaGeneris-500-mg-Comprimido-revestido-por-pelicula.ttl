             fhir:text [ fhir:v "Compromisso renal: TFG > 30 ml/min não requer ajuste; TFG 10 a 30 ml/min máximo 500 mg duas vezes por dia; TFG < 10 ml/min máximo 500 mg/dia. Hemodiálise: 500 mg a cada 24 horas, com dose adicional de 500 mg antes e após a diálise. Diálise peritoneal: máximo 500 mg/dia. Compromisso hepático: dosear com precaução e monitorizar a função hepática em intervalos regulares." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
