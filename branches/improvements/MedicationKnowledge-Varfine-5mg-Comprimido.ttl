           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A dose diária deve ser tomada sempre no mesmo horário. Devem ser realizados testes de controlo a intervalos regulares e a dose de manutenção deve ser ajustada de acordo com esses resultados; uma vez estabelecida, raramente é necessário alterá-la." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
