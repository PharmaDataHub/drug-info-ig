<http://example.com/fhir/example/MedicationKnowledge/Varfine-5mg-Comprimido> a fhir:MedicationKnowledge ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "Varfine-5mg-Comprimido"] ; # 
  fhir:meta [
     fhir:profile ( [
