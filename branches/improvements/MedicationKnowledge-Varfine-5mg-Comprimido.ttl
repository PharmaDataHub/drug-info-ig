           fhir:text [ fhir:v "A dose típica de indução com varfarina é de 10 mg por dia durante 2 dias." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Antes do início da terapêutica devem ser realizados testes de coagulação basal e testes da função hepática." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:bounds [
                 a fhir:Duration ;
                 fhir:value [ fhir:v "2"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "day" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
