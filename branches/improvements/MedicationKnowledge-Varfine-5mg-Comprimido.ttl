  fhir:name ( [ fhir:v "Varfine [varfarina] 5 mg comprimido"] ) ; # 
  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Anticoagulante oral na terapêutica e profilaxia de doenças tromboembólicas" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose de indução" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose típica de indução com varfarina é de 10 mg por dia durante 2 dias." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Antes do início da terapêutica devem ser realizados testes de coagulação basal e testes da função hepática." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:bounds [
                 a fhir:Duration ;
                 fhir:value [ fhir:v "2"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "day" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "d" ]
               ] ;
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ]
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Dose de manutenção" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose diária de manutenção é habitualmente de 2,5 mg a 10 mg, dependendo do tempo de protrombina estabelecido com o INR. O valor alvo de INR encontra-se habitualmente entre 2 e 3, exceto em casos específicos." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A dose diária deve ser tomada sempre no mesmo horário. Devem ser realizados testes de controlo a intervalos regulares e a dose de manutenção deve ser ajustada de acordo com esses resultados; uma vez estabelecida, raramente é necessário alterá-la." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ]
             ]
           ]
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Início em situações de emergência" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Em situações de emergência, a terapêutica anticoagulante deve ser iniciada com heparina e varfarina em conjunto." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "A terapêutica concomitante com heparina afeta os resultados dos testes de controlo, pelo que esta deve ser descontinuada pelo menos seis horas antes do primeiro teste ser realizado." ]
           ] )
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Início em situações menos urgentes" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Em situações menos urgentes, como em doentes dispostos ou com risco especial de tromboembolismo, a terapia anticoagulante pode ser iniciada apenas com a varfarina." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Adultos" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose mais baixa" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Usar tal como nos adultos, contudo a dose deve ser mais baixa. O idoso é normalmente mais sensível aos efeitos da varfarina e por isso requer uma dose mais baixa." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Idosos e doentes em risco de hemorragia" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Uso não recomendado" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A varfarina em comprimidos não deve ser usada em crianças uma vez que não há dados suficientes quanto à segurança e eficácia." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "População pediátrica" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose inicial inferior" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose habitual de início em doentes com insuficiência renal ligeira/moderada deve ser inferior." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Insuficiência renal ligeira/moderada" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Doses de início e de manutenção inferiores" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Doentes com insuficiência hepática ligeira/moderada requerem doses de início e de manutenção inferiores." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Insuficiência hepática ligeira/moderada" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose de indução inferior" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose de indução em doentes com insuficiência cardíaca, alimentação parentérica, baixo peso corporal e naqueles em que o baseline do tempo de protrombina é reduzido, deve ser inferior." ]
         ] )
       ] [
         fhir:type [
           fhir:text [ fhir:v "Dose de adaptação" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Pode ser necessária uma dose de adaptação nos casos de doença intercorrente (tais como infeção aguda), início ou suspensão de terapia concomitante do medicamento e numa considerável alteração na dieta." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Outras condições" ]
         ]
       ] )
     ] )
