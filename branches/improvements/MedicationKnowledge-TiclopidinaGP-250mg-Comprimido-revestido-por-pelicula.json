  "indicationGuideline" : [{
    "indication" : [{
      "concept" : {
        "text" : "Redução do risco de ocorrência e recorrência de um acidente vascular cerebral, em doentes que sofreram acidente vascular cerebral isquémico constituído, acidente vascular cerebral menor, défice neurológico reversível de origem isquémica ou acidente isquémico transitório (AIT), incluindo cegueira unilateral transitória"
      }
    }],
    "dosingGuideline" : [{
      "dosage" : [{
        "type" : {
          "text" : "Posologia habitual"
        },
        "dosage" : [{
          "text" : "A posologia habitual é de dois comprimidos por dia, a tomar durante as refeições.",
          "additionalInstruction" : [{
            "text" : "Os comprimidos devem ser ingeridos com água e sem mastigar."
          }]
        }]
      }],
      "patientCharacteristic" : [{
        "type" : {
          "text" : "Population"
        },
        "valueCodeableConcept" : {
          "text" : "Adultos"
        }
      }]
    },
