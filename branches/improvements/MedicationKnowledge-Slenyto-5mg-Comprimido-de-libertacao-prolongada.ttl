  fhir:name ( [ fhir:v "Slenyto [Melatonina] 5 mg Comprimido de libertação prolongada"] ) ; # 
  fhir:indicationGuideline ( [
     fhir:indication ( [
       fhir:concept [
         fhir:text [ fhir:v "Tratamento da insónia em crianças e adolescentes com idades entre os 2 e 18 anos com Perturbação do Espetro do Autismo (PEA) e/ou síndrome de Smith-Magenis, nos quais as medidas de higiene do sono não foram suficientes" ]
       ]
     ] ) ;
     fhir:dosingGuideline ( [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose inicial e de manutenção" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "A dose inicial recomendada é de 2 mg. Caso se verifique uma resposta inadequada, a dose deve ser aumentada para 5 mg, com uma dose máxima de 10 mg. Slenyto deve ser tomado uma vez por dia, 30 minutos a 1 hora antes da hora de deitar e com ou sem alimentos." ] ;
           fhir:additionalInstruction ( [
             fhir:text [ fhir:v "Os comprimidos devem ser deglutidos inteiros. O comprimido não deve ser partido, esmagado ou mastigado, porque irá perder as propriedades de libertação prolongada. O comprimido pode ser misturado com alimentos, como iogurte, sumo de laranja ou gelado, para facilitar a deglutição; se misturado com alimentos ou bebida, deve ser tomado de imediato e a mistura não pode ser guardada." ]
           ] [
             fhir:text [ fhir:v "Estão disponíveis dados até 2 anos de tratamento. O doente deve ser monitorizado em intervalos regulares (pelo menos de 6 em 6 meses). Após pelo menos três meses de tratamento, o médico deverá avaliar o efeito do tratamento e considerar a interrupção do mesmo, caso não seja observado qualquer efeito clinicamente relevante. Se for observado um menor efeito após o aumento da posologia, o prescritor deve primeiro considerar uma redução da posologia antes de decidir interromper totalmente o tratamento." ]
           ] [
             fhir:text [ fhir:v "Em caso de esquecimento de tomar um comprimido, este pode ser tomado antes da hora de deitar do doente, mas após este período não deve ser dado nenhum outro comprimido antes da próxima dose agendada." ]
           ] ) ;
           fhir:timing [
             fhir:repeat [
               fhir:frequency [ fhir:v "1"^^xsd:positiveInteger ] ;
               fhir:period [ fhir:v "1"^^xsd:decimal ] ;
               fhir:periodUnit [ fhir:v "d" ] ;
               fhir:when ( [ fhir:v "HS" ] ) ;
               fhir:offset [ fhir:v "30"^^xsd:nonNegativeInteger ]
             ]
           ] ;
           fhir:doseAndRate ( [
             fhir:dose [
               a fhir:Range ;
               fhir:low [
                 fhir:value [ fhir:v "2"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ] ;
               fhir:high [
                 fhir:value [ fhir:v "5"^^xsd:decimal ] ;
                 fhir:unit [ fhir:v "mg" ] ;
                 fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
                 fhir:code [ fhir:v "mg" ]
               ]
             ]
           ] ) ;
           fhir:maxDosePerPeriod ( [
             fhir:numerator [
               fhir:value [ fhir:v "10"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "mg" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "mg" ]
             ] ;
             fhir:denominator [
               fhir:value [ fhir:v "1"^^xsd:decimal ] ;
               fhir:unit [ fhir:v "day" ] ;
               fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ] ;
               fhir:code [ fhir:v "d" ]
             ]
           ] )
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Crianças e adolescentes com idades entre os 2 e 18 anos" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose em doentes com compromisso renal" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "O efeito de qualquer estádio de compromisso renal na farmacocinética da melatonina não foi estudado. Deverão ser tomadas precauções quando se administra melatonina a doentes com compromisso renal." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Doentes com compromisso renal" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Dose em doentes com compromisso hepático" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Não há experiência de utilização de melatonina em doentes com compromisso hepático. Por este motivo, não é recomendada a utilização de melatonina em doentes com compromisso hepático." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Doentes com compromisso hepático" ]
         ]
       ] )
     ] [
       fhir:dosage ( [
         fhir:type [
           fhir:text [ fhir:v "Utilização em crianças com menos de 2 anos de idade" ]
         ] ;
         fhir:dosage ( [
           fhir:text [ fhir:v "Não existe utilização relevante de melatonina em crianças dos 0 aos 2 anos para o tratamento da insónia." ]
         ] )
       ] ) ;
       fhir:patientCharacteristic ( [
         fhir:type [
           fhir:text [ fhir:v "Population" ]
         ] ;
         fhir:value [
           a fhir:CodeableConcept ;
           fhir:text [ fhir:v "Crianças com menos de 2 anos de idade" ]
         ]
       ] )
     ] )
  ] ) ; # 
