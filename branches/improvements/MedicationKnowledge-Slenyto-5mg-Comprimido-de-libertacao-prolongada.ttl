<http://example.com/fhir/example/MedicationKnowledge/Slenyto-5mg-Comprimido-de-libertacao-prolongada> a fhir:MedicationKnowledge ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "Slenyto-5mg-Comprimido-de-libertacao-prolongada"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://example.com/fhir/example/StructureDefinition/MedicationKnowledgePDH"^^xsd:anyURI ;
       fhir:link <http://example.com/fhir/example/StructureDefinition/MedicationKnowledgePDH>
