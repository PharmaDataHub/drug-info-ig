<http://example.com/fhir/example/MedicationKnowledge/Abstral-100mcg-Comprimido-sublingual> a fhir:MedicationKnowledge ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "Abstral-100mcg-Comprimido-sublingual"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://example.com/fhir/example/StructureDefinition/MedicationKnowledgePDH"^^xsd:anyURI ;
